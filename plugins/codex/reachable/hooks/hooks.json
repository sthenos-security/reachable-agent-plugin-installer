{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/bin/reachable-hook\" post_tool_use",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/bin/reachable-hook\" pre_tool_use",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${PLUGIN_ROOT}/bin/reachable-hook\" stop",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
