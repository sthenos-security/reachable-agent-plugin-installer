{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REACHABLE Agent Plugin Marketplace Manifest",
  "type": "object",
  "required": ["name", "publisher", "version", "repository", "official_site", "release_channel", "plugins"],
  "properties": {
    "name": { "type": "string" },
    "publisher": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "repository": { "type": "string", "format": "uri" },
    "official_site": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "release_channel": {
      "type": "object",
      "required": ["manifest", "installer", "frontend_role", "artifact_authority", "signing"],
      "properties": {
        "manifest": { "type": "string", "format": "uri" },
        "installer": { "type": "string", "format": "uri" },
        "frontend_role": { "const": "primary-public-download-endpoint" },
        "artifact_authority": {
          "type": "object",
          "required": ["builder_repository", "artifact_repository", "download_policy"],
          "properties": {
            "builder_repository": { "const": "https://github.com/sthenos-security/reach-core" },
            "artifact_repository": { "const": "https://github.com/sthenos-security/reach-dist" },
            "download_policy": { "const": "do-not-download-directly-use-sthenosec-frontend" }
          },
          "additionalProperties": false
        },
        "signing": {
          "type": "object",
          "required": ["scheme", "oidc_issuer", "certificate_identity_regexp", "checksums", "fail_closed"],
          "properties": {
            "scheme": { "const": "sigstore-cosign-keyless" },
            "oidc_issuer": { "const": "https://token.actions.githubusercontent.com" },
            "certificate_identity_regexp": { "type": "string" },
            "checksums": { "const": "sha256" },
            "fail_closed": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent", "name", "path", "category", "install_ux", "mcp"],
        "properties": {
          "agent": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "category": { "type": "string" },
          "install_ux": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mcp": {
            "type": "object",
            "required": ["server_name", "status", "managed_by", "verify", "configure", "runtime", "bundled"],
            "properties": {
              "server_name": { "type": "string" },
              "status": { "const": "installed-after-setup" },
              "managed_by": { "const": "reachable: setup" },
              "verify": { "const": "reachable: doctor" },
              "configure": { "const": "reachable: doctor --configure" },
              "runtime": { "type": "string" },
              "bundled": { "const": false }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
